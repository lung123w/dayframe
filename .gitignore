# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SQLite WAL/SHM files (temporary, not needed in git)
data/*.db-shm
data/*.db-wal

# User data — SQLite database and exports (never commit personal data)
data/*.db
*.export.json
*.export.csv

# Backup files in backups/ are intentionally tracked in git.
# Use the Backup button in the app to export a JSON, then move it here and commit.
!backups/*.json

# Local git worktrees
.worktrees/
